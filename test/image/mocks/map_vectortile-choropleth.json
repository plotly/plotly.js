{
  "data": [
    {
      "type": "vectortilemap",
      "source": "data:application/json;base64,",
      "sourcelayer": "squares",
      "featureidkey": "code",
      "locations": ["A", "B", "C", "D"],
      "z": [1, 2, 3, 4],
      "colorscale": "Viridis",
      "marker": {
        "line": {
          "width": 2,
          "color": "white"
        },
        "opacity": 0.9
      },
      "hovertemplate": "%{properties.name}: %{z}<extra></extra>"
    }
  ],
  "layout": {
    "width": 600,
    "height": 450,
    "margin": {
      "l": 20,
      "r": 20,
      "t": 20,
      "b": 20
    },
    "map": {
      "style": "white-bg",
      "center": {
        "lon": -95,
        "lat": 40
      },
      "zoom": 2.2
    }
  }
}
