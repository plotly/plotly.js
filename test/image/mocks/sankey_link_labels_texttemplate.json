{
  "data": [
    {
      "type": "sankey",
      "valueformat": ".0f",
      "valuesuffix": " TWh",
      "node": {
        "label": ["0", "1", "2", "3", "4", "5"],
        "color": "gray"
      },
      "link": {
        "source": [0, 1, 4, 2, 1],
        "target": [1, 4, 5, 4, 3],
        "value": [4, 2, 3, 1, 2],
        "label": ["a", "b", "c", "d", "e"],
        "customdata": ["cd0", "cd1", "cd2", "cd3", "cd4"],
        "color": [
          "rgba(230, 25, 75, 0.6)",
          "rgba(255, 165, 0, 0.6)",
          "rgba(60, 180, 75, 0.6)",
          "rgba(0, 130, 200, 0.6)",
          "rgba(145, 30, 180, 0.6)"
        ],
        "texttemplate": [
          "%{label}",
          "%{value}",
          "%{valueLabel}",
          "%{source}/%{target}",
          "%{customdata}"
        ],
        "textfont": { "family": "Times New Roman", "size": 14, "color": "black" }
      }
    }
  ],
  "layout": {
    "title": { "text": "Sankey with permanent link labels from texttemplate" },
    "width": 800,
    "height": 800
  }
}
