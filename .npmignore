# Exclude all hidden files and folders
.*

# Exclude all files in build/, except for those required when bundling the package
build/*
!build/plotcss.js
!build/maplibre_worker.js
!build/README.md

# Exclude these directories
devtools
dist/extras
draftlogs
stackgl_modules/node_modules
tasks
test
topojson

# Exclude the TypeScript files (but not declarations) because Node doesn't
# parse TS when installed in node_modules.
src/**/*.ts
!src/**/*.d.ts
